<IfModule mod_rewrite.c>
RewriteEngine On

# Exclude existing physical files and directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Special case for Admin directory
RewriteRule ^admin/?$ admin/login.php [L,NC]
RewriteRule ^Admin/?$ admin/login.php [L,NC]

# Blog post rewrite rule: /blog/slug -> post.php?slug=slug
RewriteRule ^blog/([^/]+)/?$ post.php?slug=$1 [L,QSA,NC]

# ==============================
# Handle Services with clean URLs
# ==============================
RewriteRule ^services/?$ services.php [L,NC]
RewriteRule ^service/([a-z0-9\-]+)/?$ $1.php [L,NC]
RewriteRule ^services/departments/([^/]+)/?$ $1.php [L,NC]

# ==============================
# Handle Doctors with clean URLs
# ==============================
RewriteRule ^team/?$ doctors.php [L,NC]
RewriteRule ^doctors/?$ doctors.php [L,NC]
RewriteRule ^team/([^/]+)/?$ $1.php [L,NC]
RewriteRule ^Dr-([A-Za-z0-9\-]+)/?$ team/Dr-$1 [R=301,L,NC]

# ==============================
# Explicit rules for department pages
# ==============================
RewriteRule ^departments/obg/?$ departments/obg.php [L,NC]
RewriteRule ^departments/gastro-liver-treatment/?$ departments/gastro-liver-treatment.php [L,NC]
RewriteRule ^departments/neurosurgery/?$ departments/neurosurgery.php [L,NC]
RewriteRule ^departments/orthopaedics/?$ departments/orthopaedics.php [L,NC]
RewriteRule ^departments/general-surgery/?$ departments/general-surgery.php [L,NC]
RewriteRule ^departments/urology-treatment/?$ departments/urology-treatment.php [L,NC]

# Main pages
RewriteRule ^specialties/?$ specialties.php [L,NC]
RewriteRule ^gallery/?$ gallery.php [L,NC]
RewriteRule ^contact/?$ contact.php [L,NC]
RewriteRule ^about/?$ about.php [L,NC]
RewriteRule ^appointment/?$ appointment.php [L,NC]
RewriteRule ^faqs/?$ faqs.php [L,NC]
RewriteRule ^timetable/?$ timetable.php [L,NC]

# ==============================
# Remove .php extension from URLs
# ==============================
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/]+)/?$ $1.php [L,QSA]
</IfModule>
